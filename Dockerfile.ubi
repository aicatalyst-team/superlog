# Build context: repo root.
# UBI-based Dockerfile for Superlog API component
# Build with: podman build -t superlog-api -f Dockerfile.ubi .

FROM registry.access.redhat.com/ubi9/nodejs-22

WORKDIR /opt/app-root/src

# Install pnpm globally and fix directory permissions for pnpm install
USER 0
RUN npm install -g pnpm@9.12.0

# Copy workspace root files for pnpm install
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy package.json files for all needed workspaces
COPY apps/api/package.json apps/api/
COPY packages/db/package.json packages/db/
COPY packages/fingerprint/package.json packages/fingerprint/

# Fix ownership so user 1001 can create node_modules in subdirectories
RUN chown -R 1001:0 /opt/app-root/src
USER 1001

# Install dependencies (frozen lockfile for reproducibility)
RUN pnpm install --frozen-lockfile --filter @superlog/api...

# Copy TypeScript config and source code
COPY tsconfig.base.json ./
COPY apps/api apps/api
COPY packages/db packages/db
COPY packages/fingerprint packages/fingerprint

# OpenShift compatibility: ensure group 0 can read/write
USER 0
RUN chgrp -R 0 /opt/app-root && chmod -R g=u /opt/app-root
USER 1001

ENV PORT=4100
EXPOSE 4100

CMD ["pnpm", "--filter", "@superlog/api", "start"]
